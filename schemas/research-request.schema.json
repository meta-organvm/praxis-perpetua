{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organvm.dev/schemas/sgo/research-request.schema.json",
  "title": "ResearchRequest",
  "description": "Provider-neutral request contract for an SGO research commission.",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "requested_at",
    "question",
    "required_capabilities",
    "verification_strength",
    "preservation_tier",
    "external_transmission",
    "latency_ceiling_seconds",
    "spend_ceiling",
    "output_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^SGO-REQ-[0-9]{4}-[A-Z0-9-]+$"
    },
    "commission_id": {
      "type": ["string", "null"],
      "pattern": "^INQ-[0-9]{4}-[0-9]{3}$"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "question": {
      "type": "string",
      "minLength": 10
    },
    "context_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "owner_repo",
          "path"
        ],
        "properties": {
          "owner_repo": {
            "type": "string",
            "minLength": 3
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "freshness": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "retrieved_after": {
          "type": "string",
          "format": "date"
        },
        "published_after": {
          "type": "string",
          "format": "date"
        },
        "published_before": {
          "type": "string",
          "format": "date"
        },
        "max_source_age_days": {
          "type": "integer",
          "minimum": 0
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "domain_constraints": {
      "type": "object",
      "properties": {
        "allow_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deny_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "jurisdictions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]+)*$"
          }
        }
      },
      "additionalProperties": false
    },
    "verification_strength": {
      "enum": [
        "basic",
        "corroborated",
        "primary_source",
        "systematic"
      ]
    },
    "preservation_tier": {
      "enum": [
        "public_facing",
        "operational_internal",
        "client_private",
        "essence_private"
      ]
    },
    "external_transmission": {
      "enum": [
        "public_only",
        "sanitized_only",
        "forbidden"
      ]
    },
    "latency_ceiling_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "spend_ceiling": {
      "type": "object",
      "required": [
        "currency",
        "variable_cost"
      ],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "variable_cost": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "output_contract": {
      "type": "object",
      "required": [
        "format",
        "owner_repo",
        "report_path",
        "receipt_path"
      ],
      "properties": {
        "format": {
          "enum": [
            "markdown",
            "json"
          ]
        },
        "owner_repo": {
          "type": "string",
          "minLength": 3
        },
        "report_path": {
          "type": "string",
          "minLength": 1
        },
        "receipt_path": {
          "type": "string",
          "minLength": 1
        },
        "raw_export_ref": {
          "type": ["string", "null"]
        },
        "required_sections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "preservation_tier"
        ],
        "properties": {
          "preservation_tier": {
            "enum": [
              "client_private",
              "essence_private"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "output_contract": {
            "properties": {
              "raw_export_ref": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^private-owner://"
                  }
                ]
              }
            }
          },
          "external_transmission": {
            "const": "forbidden"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}

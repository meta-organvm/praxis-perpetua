{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organvm.dev/schemas/sgo/research-receipt.schema.json",
  "title": "ResearchReceipt",
  "description": "Sanitized provenance, usage, verification, and custody receipt for an SGO research outcome.",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "request_id",
    "request_hash",
    "catalog_hash",
    "selected_profile",
    "observed_provider",
    "observed_model",
    "retrieval_started_at",
    "retrieval_finished_at",
    "source_manifest_hash",
    "outcome_type",
    "usage",
    "verification",
    "durable_output",
    "privacy",
    "sanitization"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^SGO-RCT-[0-9]{4}-[A-Z0-9-]+$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^SGO-REQ-[0-9]{4}-[A-Z0-9-]+$"
    },
    "request_hash": {
      "$ref": "#/$defs/Hash"
    },
    "catalog_hash": {
      "$ref": "#/$defs/Hash"
    },
    "selected_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "observed_provider": {
      "type": ["string", "null"]
    },
    "observed_model": {
      "type": ["string", "null"]
    },
    "retrieval_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "retrieval_finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_manifest_hash": {
      "$ref": "#/$defs/Hash"
    },
    "outcome_type": {
      "enum": [
        "EvidencePacket",
        "ManualHandoff",
        "BlockedReceipt"
      ]
    },
    "usage": {
      "type": "object",
      "required": [
        "currency",
        "variable_cost",
        "requests",
        "computer_credits",
        "operator_handling_seconds",
        "usage_source"
      ],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "variable_cost": {
          "type": "number",
          "minimum": 0
        },
        "requests": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "output_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "computer_credits": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "operator_handling_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "usage_source": {
          "enum": [
            "provider_reported",
            "locally_observed",
            "not_exposed"
          ]
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "verified_at",
        "verifier",
        "material_claims",
        "supported_material_claims",
        "resolvable_citations",
        "total_citations",
        "primary_source_citations",
        "primary_source_ratio"
      ],
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "rejected",
            "manual_pending"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "verifier": {
          "type": "string",
          "minLength": 1
        },
        "material_claims": {
          "type": "integer",
          "minimum": 0
        },
        "supported_material_claims": {
          "type": "integer",
          "minimum": 0
        },
        "resolvable_citations": {
          "type": "integer",
          "minimum": 0
        },
        "total_citations": {
          "type": "integer",
          "minimum": 0
        },
        "primary_source_citations": {
          "type": "integer",
          "minimum": 0
        },
        "primary_source_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rejection_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "durable_output": {
      "type": "object",
      "required": [
        "owner_repo",
        "report_path",
        "receipt_path"
      ],
      "properties": {
        "owner_repo": {
          "type": "string",
          "minLength": 3
        },
        "report_path": {
          "type": "string",
          "minLength": 1
        },
        "receipt_path": {
          "type": "string",
          "minLength": 1
        },
        "raw_export_ref": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": [
        "preservation_tier",
        "external_transmission",
        "tracked_output_safe",
        "raw_export_disposition",
        "private_connected_sources_used",
        "redactions_applied"
      ],
      "properties": {
        "preservation_tier": {
          "enum": [
            "public_facing",
            "operational_internal",
            "client_private",
            "essence_private"
          ]
        },
        "external_transmission": {
          "enum": [
            "public_only",
            "sanitized_only",
            "forbidden"
          ]
        },
        "tracked_output_safe": {
          "type": "boolean"
        },
        "raw_export_disposition": {
          "enum": [
            "tracked_owner_repo",
            "private_owner",
            "not_retained"
          ]
        },
        "private_connected_sources_used": {
          "const": false
        },
        "redactions_applied": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "sanitization": {
      "type": "object",
      "required": [
        "contains_credentials",
        "contains_private_prompt_body",
        "contains_sensitive_raw_material"
      ],
      "properties": {
        "contains_credentials": {
          "const": false
        },
        "contains_private_prompt_body": {
          "const": false
        },
        "contains_sensitive_raw_material": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "Hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}

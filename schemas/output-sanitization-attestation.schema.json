{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organvm.dev/schemas/sgo/output-sanitization-attestation.schema.json",
  "title": "OutputSanitizationAttestation",
  "description": "Machine-readable proof that binds the exact raw Markdown export while attesting that normalized tracked derivatives satisfy the request's privacy boundary.",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "attested_at",
    "attestor",
    "export_hash",
    "preservation_tier",
    "external_transmission",
    "tracked_output_safe",
    "contains_credentials",
    "contains_private_prompt_body",
    "contains_sensitive_raw_material",
    "redactions_applied"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^SGO-REQ-[0-9]{4}-[A-Z0-9-]+$"
    },
    "attested_at": {
      "type": "string",
      "format": "date-time"
    },
    "attestor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "export_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 of the exact raw Markdown UTF-8 text consumed by ingestion."
    },
    "preservation_tier": {
      "enum": [
        "public_facing",
        "operational_internal",
        "client_private",
        "essence_private"
      ]
    },
    "external_transmission": {
      "enum": [
        "public_only",
        "sanitized_only",
        "forbidden"
      ]
    },
    "tracked_output_safe": {
      "const": true,
      "description": "The normalized EvidencePacket, tracked report, and receipt are safe to track."
    },
    "contains_credentials": {
      "const": false,
      "description": "Tracked derivatives contain no credentials."
    },
    "contains_private_prompt_body": {
      "const": false,
      "description": "Tracked derivatives contain no private prompt body; this assertion does not describe the private raw export."
    },
    "contains_sensitive_raw_material": {
      "const": false,
      "description": "Tracked derivatives contain no sensitive raw material."
    },
    "redactions_applied": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
